# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Notifications (Resend)
# Sign up at https://resend.com and add your API key to enable email delivery
# Without this key, restock notifications and alerts are saved in-app only
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=CampusLoop <notifications@yourdomain.com>

# Optional campus email confirmation. Apply supabase/account-verification.sql first.
CAMPUS_VERIFICATION_DOMAINS=
CAMPUS_VERIFICATION_SECRET=

# Optional hosted Aadhaar identity check. Leave disabled until onboarded.
# Configure sandbox or production credentials separately. Use an HTTPS app origin with no trailing slash.
SETU_AADHAAR_MODE=disabled
SETU_AADHAAR_PRODUCTION_APPROVED=false
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
VERIFICATION_APP_ORIGIN=
